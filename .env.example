# Copy this file to ".env" and fill in at least one key.
# With no key at all the app still runs in offline demo mode.

# --- Main AI: Google Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Fast model first, then a stronger backup. Comma-separated.
GEMINI_MODEL=gemini-flash-lite-latest,gemini-flash-latest

# --- Backup AI: Groq (free key: https://console.groq.com/keys) or any OpenAI-compatible API
# Used automatically if Gemini fails or times out.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
#   For OpenAI itself: OPENAI_BASE_URL=https://api.openai.com/v1  OPENAI_MODEL=gpt-4o-mini

# --- Optional
# AI_PROVIDER=gemini      # which AI to try first: gemini | openai | offline
# AI_TIMEOUT=45           # seconds to wait for each model before trying the next
# GOOGLE_CLIENT_ID=...    # your own Google OAuth client ID for "Sign in with Google"
